filters:
  and:
    - file.inFolder("Narrative data/Outcome")
views:
  - type: table
    name: Table
    order:
      - file.name
      - Outcome ID
      - Response ID
      - Outcome name
      - Outcome type
      - Outcome response
      - EXP gain
      - Add item ID
      - Subtract item ID
      - Condition target 1
      - Condition dice 1 type modification
      - Condition dice 1 ID
      - Condition dice 1 influenced skill type
      - Condition target 2
      - Condition dice 2 type modification
      - Condition dice 2 ID
      - Condition dice 2 influenced skill type
      - Condition target 3
      - Condition dice 3 type modification
      - Condition dice 3 ID
      - Condition dice 3 influenced skill type
      - Special dice face 1 addition
      - Special dice face 2 addition
      - Special dice face 3 addition
      - tags
    sort: []
    columnSize:
      note.Response ID: 358
      note.Outcome name: 181
      note.Outcome response: 327
      note.Condition dice 3 type modification: 174
      note.Condition dice 3 ID: 201
