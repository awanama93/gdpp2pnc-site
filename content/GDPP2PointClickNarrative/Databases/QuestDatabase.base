views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Narrative data/Quest")
    order:
      - file.name
      - Quest ID
      - Quest name
      - Quest type
      - Status
      - Quest description
      - Hints
      - Starter prerequisite type
      - Starter item ID
      - Starter quest ID
      - Starter response ID
      - Completion prerequisite type
      - Completion quest ID
      - Completion item ID
      - Skill check result
      - Completion response ID
      - tags
    sort: []
    columnSize:
      note.Quest name: 262
      note.Quest description: 311
      note.Hints: 242
      note.Completion response ID: 340
  - type: table
    name: View
