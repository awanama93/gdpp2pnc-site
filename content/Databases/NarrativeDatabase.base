filters:
  and:
    - file.inFolder("Narrative data/Narrative")
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Narrative data/Narrative")
    order:
      - file.name
      - Narrative_ID
      - Narrative_name
      - Exposition
      - Narrative_completion_status
      - Responses
      - Response_ID_relation
      - tags
    sort: []
    columnSize:
      note.Narrative_ID: 133
      note.Narrative_name: 173
      note.Exposition: 434
      note.Responses: 334
  - type: table
    name: ResponseView
    order:
      - file.name
      - Responses
      - Response_ID_relation
    columnSize:
      note.Responses: 323
  - type: table
    name: ResponseExpositionView
    order:
      - file.name
      - Responses
      - Exposition
    columnSize:
      note.Responses: 319
      note.Exposition: 434
