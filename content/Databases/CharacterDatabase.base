filters:
  and:
    - file.inFolder("Character")
views:
  - type: table
    name: Table
    order:
      - file.name
      - Character_ID
      - Narrative_data
      - Mesh
      - Dialogue_position
      - DiceStrength
      - DiceReflex
      - DiceArtistry
      - DiceDeception
      - DiceKnowledge
      - DiceObservation
      - tags
    sort: []
    columnSize:
      note.Character_ID: 177
      note.Narrative_data: 232
    rowHeight: extra
  - type: table
    name: MeshView
    order:
      - file.name
      - Mesh
  - type: table
    name: StarterDiceView
    order:
      - file.name
      - DiceStrength
      - DiceReflex
      - DiceArtistry
      - DiceDeception
      - DiceKnowledge
      - DiceObservation
