views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Narrative data/Quest")
    order:
      - file.name
      - Quest_ID
      - Quest_name
      - Quest_type
      - Status
      - Quest_description
      - Hints
      - Starter_prerequisite_type
      - Starter_item_ID
      - Starter_quest_ID
      - Starter_response_ID
      - Completion_prerequisite_type
      - Completion_quest_ID
      - Completion_item_ID
      - Skill_check_result
      - Completion_response_ID
      - tags
    sort: []
    columnSize:
      note.Quest name: 262
      note.Quest description: 311
      note.Hints: 242
      note.Completion response ID: 340
  - type: table
    name: View
